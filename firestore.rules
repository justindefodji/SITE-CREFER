rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pages et sections : lecture publique, écriture réservée aux admins authentifiés
    match /pages/{pageId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /sections/{sectionId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // Articles : lecture publique, écriture admin uniquement
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Galerie : lecture publique, écriture admin uniquement
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Admissions : lecture publique, écriture admin uniquement
    match /admissions/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Vidéos : lecture publique, écriture admin uniquement
    match /videos/{videoId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Images liées aux articles
    match /articleImages/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Images d'admission
    match /admissions_images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Documents d'admission (PDF en base64)
    match /admissions_documents/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tout autre document : refusé par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
