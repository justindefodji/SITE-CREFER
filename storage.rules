rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Documents d'admission : lecture publique, upload réservé aux admins
    match /admissions_documents/{docId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Images d'admission
    match /admissions_images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tout autre fichier : refusé
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
